@echo off
REM Generated by MiniMax M3.1 Flash without human creative authorship.
REM SPDX-License-Identifier: LGPL-2.0-or-later
REM
REM Stage the PIME installer payload under .tools\stage\ so that installer\installer.nsi
REM resolves its "..\build\..." style paths against the staging root.
REM
REM Layout produced:
REM   .tools\stage\build\...        x86 launcher + x86 PIMETextService.dll
REM   .tools\stage\build64\...      x64 PIMETextService.dll
REM   .tools\stage\build_arm64\...  ARM64X forwarder + native ARM64 DLL
REM   .tools\stage\python           junction -> repo python\
REM   .tools\stage\node             junction -> repo node\
REM   .tools\stage\installer        copy of repo installer\ (sources are NOT modified)
setlocal
REM Resolve the repository root once, so no path in this script carries a
REM ".." component: cmd's copy and mklink handle those badly.
pushd "%~dp0.."
set REPO=%CD%
popd
set STAGE=%REPO%\.tools\stage

if exist "%STAGE%" rmdir /s /q "%STAGE%"
mkdir "%STAGE%\build\PIMELauncher"
mkdir "%STAGE%\build\PIMETextService\Release"
mkdir "%STAGE%\build64\PIMETextService\Release"
mkdir "%STAGE%\build_arm64\PIMETextService\Release"
mkdir "%STAGE%\installer"

REM --- repo-root files referenced by the installer script ---
copy /y "%REPO%\version.txt"     "%STAGE%\version.txt"     >nul
copy /y "%REPO%\backends.json"   "%STAGE%\backends.json"   >nul
copy /y "%REPO%\LGPL-2.0.txt"    "%STAGE%\LGPL-2.0.txt"    >nul
copy /y "%REPO%\PSF.txt"         "%STAGE%\PSF.txt"         >nul

REM --- installer sources (copy; upstream installer\ stays untouched) ---
copy /y "%REPO%\installer\installer.nsi" "%STAGE%\installer\installer.nsi" >nul
copy /y "%REPO%\installer\macros.nsh"    "%STAGE%\installer\macros.nsh"    >nul
mkdir "%STAGE%\installer\locale"
copy /y "%REPO%\installer\locale\*.nsh"  "%STAGE%\installer\locale\"       >nul
mkdir "%STAGE%\installer\StdUtils.2015-11-16\Plugins\Release_Unicode"
copy /y "%REPO%\installer\StdUtils.2015-11-16\Plugins\Release_Unicode\StdUtils.dll" "%STAGE%\installer\StdUtils.2015-11-16\Plugins\Release_Unicode\" >nul
mkdir "%STAGE%\installer\StdUtils.2015-11-16\Include"
copy /y "%REPO%\installer\StdUtils.2015-11-16\Include\StdUtils.nsh" "%STAGE%\installer\StdUtils.2015-11-16\Include\" >nul

REM --- binaries ---
copy /y "%REPO%\.tools\build-x86\PIMELauncher\PIMELauncher.exe" "%STAGE%\build\PIMELauncher\" >nul
copy /y "%REPO%\.tools\build-x86\PIMETextService\PIMETextService.dll" "%STAGE%\build\PIMETextService\Release\" >nul
copy /y "%REPO%\.tools\build-x64\PIMETextService\PIMETextService.dll" "%STAGE%\build64\PIMETextService\Release\" >nul
copy /y "%REPO%\.tools\build-arm64\PIMETextService\PIMETextService_arm64.dll" "%STAGE%\build_arm64\PIMETextService\Release\" >nul
REM The ARM64X forwarder, built by tests\arm64x\build-forwarder.sh.
if not exist "%REPO%\.tools\build-arm64\PIMETextService\PIMETextService.dll" (
  echo ERROR: ARM64X forwarder is missing; run tests\build_windows_artifacts.sh first.
  exit /b 1
)
copy /y "%REPO%\.tools\build-arm64\PIMETextService\PIMETextService.dll" "%STAGE%\build_arm64\PIMETextService\Release\" >nul

REM --- big payload trees as junctions (NSIS traverses them recursively) ---
mklink /J "%STAGE%\python" "%REPO%\python"
mklink /J "%STAGE%\node"   "%REPO%\node"

REM --- the installer script cannot open a file it does not find, and the
REM --- failure only shows up as a makensis error much later on.
for %%F in (
  "%STAGE%\version.txt"
  "%STAGE%\backends.json"
  "%STAGE%\LGPL-2.0.txt"
  "%STAGE%\PSF.txt"
  "%STAGE%\installer\installer.nsi"
  "%STAGE%\installer\macros.nsh"
  "%STAGE%\installer\StdUtils.2015-11-16\Include\StdUtils.nsh"
  "%STAGE%\installer\StdUtils.2015-11-16\Plugins\Release_Unicode\StdUtils.dll"
  "%STAGE%\build\PIMELauncher\PIMELauncher.exe"
  "%STAGE%\build\PIMETextService\Release\PIMETextService.dll"
  "%STAGE%\build64\PIMETextService\Release\PIMETextService.dll"
  "%STAGE%\build_arm64\PIMETextService\Release\PIMETextService.dll"
  "%STAGE%\build_arm64\PIMETextService\Release\PIMETextService_arm64.dll"
) do (
  if not exist %%F (
    echo ERROR: staging is incomplete, %%F is missing.
    exit /b 1
  )
)

endlocal
echo Staging done: %STAGE%
