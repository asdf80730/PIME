#!/usr/bin/env bash
# Pre-commit gate for the integration checkout: runs the Python backend suite
# and the staged AI-declaration check before every commit, so neither a broken
# fast layer nor an undeclared added file lands on local/linux-master.
# The suite's slow layer is regenerating all 35
# committed cinbase tables through the converter (~3 min) and only the cinbase
# table files can break it, so the gate spends it only when a staged path can
# affect it: a ~25 s commit otherwise, ~3½ min when you touch a table.
# The full gate stays `bash tests/verify_windows.sh`. A worktree whose checked-out
# branch does not track tests/ (product branches cut from upstream master) skips:
# the probe is a tracked file, not the directory, which a stale branch ref can
# still leave on disk.
# Install: cp tests/hooks/pre-commit .git/hooks/ && chmod +x .git/hooks/pre-commit
# Generated by omp (Qwen3.8-Flash-Next) without human creative authorship.
# SPDX-License-Identifier: LGPL-2.1-or-later
set -u
# Discovery writes bytecode unless told not to; the product .gitignore does not
# cover __pycache__, so a cache created here is one `git add -A` away from a commit
# that tests/check_pr_scope.sh then fails.
export PYTHONDONTWRITEBYTECODE=1

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
git -C "$root" ls-files --error-unmatch tests/ime_smoke_runner.py >/dev/null 2>&1 || exit 0

py="$root/python/python3/python.exe"
if [ ! -f "$py" ]; then
    py=$(command -v python3 || command -v python) || exit 0
fi

# Only these paths feed the converter run: the sources, the shipped JSON, the
# converter and generators, and the check itself.
if ! git diff --cached --name-only --diff-filter=ACMRD -- \
        'python/cinbase/cin' 'python/cinbase/json' 'python/cinbase/tools' \
        'tests/test_cinbase_tables.py' | grep -q .; then
    PIME_SKIP_TABLE_REGEN=1
    export PIME_SKIP_TABLE_REGEN
fi

# The declaration check against HEAD cannot see the commit still in the
# index, so the gate judges the staged files directly: the one class of
# convention break the suite cannot see. It runs first because it costs
# milliseconds and the suite does not.
if ! (cd "$root" && bash tests/check_ai_declarations.sh staged); then
    printf 'pre-commit: every added file needs its AI declaration header\n' >&2
    printf '(AGENTS.md §4); copy the two-line form from any sibling file.\n' >&2
    exit 1
fi

suite_log="$root/.git/pime-pre-commit-suite.log"
if ! (cd "$root" && "$py" -m unittest discover -s tests -p 'test_*.py' >"$suite_log" 2>&1); then
    printf 'pre-commit: Python backend suite failed. Failing tests:\n' >&2
    grep -E '^(FAIL|ERROR): ' "$suite_log" | head -n 10 >&2
    printf 'Full log: %s\n' "$suite_log" >&2
    printf 'Reproduce one file with:\n' >&2
    printf '  python/python3/python.exe -m unittest discover -s tests -p "test_<name>.py" -v\n' >&2
    printf 'Commit through it with git commit --no-verify only for a deliberately\n' >&2
    printf 'mid-refactor commit that the next commit makes green.\n' >&2
    exit 1
fi
rm -f "$suite_log"
