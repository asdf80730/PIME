#!/usr/bin/env bash
# Pre-commit gate for the integration checkout: runs the Python backend suite
# on the shipped interpreter (~5 s) before every commit, so a broken fast
# layer cannot land on local/linux-master unnoticed. Worktrees that do not
# track tests/ (product branches cut from upstream master) skip; the full
# gate stays `bash tests/verify_windows.sh`.
# Install: cp tests/hooks/pre-commit .git/hooks/ && chmod +x .git/hooks/pre-commit
# Generated by omp (Qwen3.8-Flash-Next) without human creative authorship.
# SPDX-License-Identifier: LGPL-2.1-or-later
set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -d "$root/tests" ] || exit 0

py="$root/python/python3/python.exe"
if [ ! -f "$py" ]; then
    py=$(command -v python3 || command -v python) || exit 0
fi

if ! (cd "$root" && "$py" -m unittest discover -s tests -p 'test_*.py' >/dev/null 2>&1); then
    printf 'pre-commit: Python backend suite failed. Reproduce with:\n' >&2
    printf '  python/python3/python.exe -m unittest discover -s tests -p "test_*.py" -v\n' >&2
    printf 'Commit through it with git commit --no-verify only for a deliberately\n' >&2
    printf 'mid-refactor commit that the next commit makes green.\n' >&2
    exit 1
fi
